TARGET_PRODUCT=FroggerPro
NT_PROJECT=FroggerPro
echo "!!! build.config.nothing.FroggerPro: TARGET_PRODUCT=${TARGET_PRODUCT} !!!"
echo "!!! build.config.nothing.FroggerPro: NT_PROJECT=${NT_PROJECT} !!!"
apply_defconfig_fragment ${KERNEL_DIR}/arch/${ARCH}/configs/vendor/${TARGET_PRODUCT}.config

echo "!!! add  -DNT_PROJECT=${TARGET_PRODUCT}"
export KBUILD_CFLAGS+=" -DNT_PROJECT=${TARGET_PRODUCT}"
