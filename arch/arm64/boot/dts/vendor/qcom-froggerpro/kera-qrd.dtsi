&tlmm {
	hwid_gpio_default: hwid_gpio_default {
		mux {
			pins = "gpio179","gpio180","gpio181","gpio182","gpio184";
			function = "gpio";
		};
		config {
			pins = "gpio179","gpio180","gpio181","gpio182","gpio184";
			bias-disable;
			input-enable;
		};
	};
};
&soc {
	hwid_gpioi: hwid_gpio {
		compatible = "gpio,board-id,FroggerPro";
		board_id_gpio0 = <&tlmm 179 0>;
		board_id_gpio1 = <&tlmm 180 0>;
		board_id_gpio2 = <&tlmm 181 0>;
		board_id_gpio3 = <&tlmm 182 0>;
		board_id_gpio4 = <&tlmm 184 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&hwid_gpio_default>;
		status = "okay";
	};
};

&soc {
	bootloader_log {
		compatible = "nothing,bootloader_log";
		memory-region = <&uefi_log_mem>;
	};
	nothing_secure_element {
		compatible = "nothing,secure_element";
		// HWIO_OEM_SECURITY_POLICY_LSB_ADDR
		oem_sec_boot_addr = <0x221c8cf0>;
	};
};

#include "fingerprint.dtsi"
